FROM mcr.microsoft.com/playwright/python:v1.40.0-jammy

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright browsers (Firefox specifically needed)
RUN playwright install firefox
RUN playwright install-deps

# Copy shared library
COPY ./shared ./shared

# Copy the WTTJ service
COPY ./services/wttj ./services/wttj

# Ensure screenshots and profile directories exist
RUN mkdir -p screenshots firefox_profile

EXPOSE 8012

# Run Uvicorn
CMD ["python", "-m", "uvicorn", "services.wttj.app.main:app", "--host", "0.0.0.0", "--port", "8012"]
