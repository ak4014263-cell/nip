# =============================================================================
# SWIPLY PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your production values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=swiply
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
POSTGRES_DB=swiply
DATABASE_URL=postgresql://swiply:CHANGE_THIS_STRONG_PASSWORD_123!@postgres:5432/swiply

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# OPENAI API CONFIGURATION
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# ENCRYPTION & SECURITY
# =============================================================================
# Generate a secure 32-byte key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# JWT Secret (for future authentication)
JWT_SECRET=your-jwt-secret-key-here

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Your VPS IP or domain
VITE_API_URL=http://your-vps-ip:8000
# or with domain:
# VITE_API_URL=https://api.yourdomain.com

# =============================================================================
# EMAIL CONFIGURATION (Optional - for future features)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment: development, staging, production
NODE_ENV=production
PYTHON_ENV=production

# Debug mode (set to false in production)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# BROWSER AUTOMATION
# =============================================================================
# Run browsers in headless mode (recommended for VPS)
HEADLESS=true

# =============================================================================
# RATE LIMITING (Optional)
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://your-vps-ip:5173,https://yourdomain.com

# =============================================================================
# STORAGE PATHS
# =============================================================================
UPLOAD_DIR=/app/uploads
RESUME_DIR=/app/resumes
SCREENSHOT_DIR=/app/screenshots

# =============================================================================
# NOTES
# =============================================================================
# 1. Generate strong passwords for production
# 2. Never expose sensitive ports (5432, 6379) to the internet
# 3. Use environment-specific values for each deployment
# 4. Regularly rotate secrets and API keys
# 5. Keep this file secure and never commit to git
